# Copy to .env (never commit .env). Only OPENAI_API_KEY is required for the AI features.
OPENAI_API_KEY=
# Hosted mode: students log in with their own GitHub. Create an OAuth App at
# https://github.com/settings/developers with callback URL  BASE_URL + /auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BASE_URL=http://localhost:8000
# Local single-user mode (no client id above): optional GitHub token. If empty, the server reuses your local `gh auth token` for read access.
GITHUB_TOKEN=
# Model tiers (cheap = triage/classification, smart = teaching/drafting)
MODEL_CHEAP=gpt-4.1-mini
MODEL_SMART=gpt-4.1
# Spend caps in USD
SESSION_BUDGET_USD=0.50
GLOBAL_BUDGET_USD=10.00
# Replying on GitHub is OFF by default. Turn on only for repos whose policy allows AI-drafted messages.
AUTO_POST_REPLIES=false
AI_DISCLOSURE=Drafted with AI assistance and reviewed by the author.

# ---- Public deployment (Vercel). The API refuses to run publicly until ALL of these are set. ----
# A random string of 32+ characters: encrypts the sign-in cookie. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Postgres connection string (Neon, Supabase, Vercel Postgres...). Leave empty locally: SQLite is used.
DATABASE_URL=
# Comma-separated GitHub logins allowed to trigger a catalogue refresh in production
ADMIN_LOGINS=
